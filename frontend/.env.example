# SpendWise Frontend Environment Variables

# Backend API Endpoint
VITE_API_URL=https://spendwise-backend-zf55.onrender.com

# Google OAuth 2.0 Client ID (Web Application Client ID from Google Cloud Console)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Format: xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
